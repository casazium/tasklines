filters:
  and:
    - file.inFolder("Projects")
views:
  - type: tasklines
    name: Open tasks
    order:
      - file.name
      - note.status
      - note.owner
    groupBy:
      property: note.area
      direction: ASC
    taskCol_section: true
    taskQuery:
      statuses: [todo, in-progress]
      sort:
        - key: due
          desc: false
        - key: priority
          desc: false
      group: bases
  - type: tasklines
    name: Due soon by owner
    order:
      - file.name
      - note.owner
    taskQuery:
      due: next30
      group: prop:note.owner
      sort:
        - key: due
          desc: false
  - type: tasklines
    name: All tasks by section
    order:
      - file.name
      - note.owner
    taskCol_tags: true
    taskCol_recurrence: true
    taskCol_line: true
    taskQuery:
      group: section
