filters:
  and:
    - file.inFolder("Projects")
views:
  - type: task-rows
    name: Open tasks
    order:
      - file.name
      - note.status
      - note.owner
    groupBy:
      property: note.area
      direction: ASC
    hideCompleted: true
    taskSort: due
    taskGroup: bases
    taskCol_section: true
  - type: task-rows
    name: All tasks by section
    order:
      - file.name
      - note.owner
    taskGroup: section
    taskCol_tags: true
    taskCol_recurrence: true
    taskCol_line: true
