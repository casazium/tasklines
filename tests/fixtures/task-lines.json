    "expect": {
      "priority": "high",
      "recurrence": "every week on Monday",
      "start": "2026-11-01",
      "scheduled": "2026-11-10",
      "due": "2026-11-20",
      "done": "2026-11-19",
      "tags": [
        "#work"
      ],
      "text": "Ship release #work",
      "format": "tasks-emoji"
    }
  },
  {
    "name": "Tasks: created and cancelled",
