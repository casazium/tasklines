[
  {
    "name": "plain open task",
    "line": "- [ ] Buy milk",
    "expect": {
      "status": " ",
      "text": "Buy milk",
      "format": "plain",
      "priority": "none"
    }
  },
  {
    "name": "asterisk and plus markers",
    "line": "+ [x] Done thing",
    "expect": {
      "marker": "+",
      "status": "x",
      "text": "Done thing"
    }
  },
  {
    "name": "uppercase X",
    "line": "* [X] Shout",
    "expect": {
      "status": "X"
    }
  },
  {
    "name": "numbered list with paren",
    "line": "3) [ ] Third",
    "expect": {
      "marker": "3)",
      "text": "Third"
    }
  },
  {
    "name": "tab-indented subtask",
    "line": "\t\t- [ ] Deep",
    "expect": {
      "indent": "\t\t",
      "text": "Deep"
    }
  },
  {
    "name": "blockquote and callout prefix",
    "line": "> > - [ ] Nested quote",
    "expect": {
      "text": "Nested quote"
    }
  },
  {
    "name": "custom status characters",
    "line": "- [>] Forwarded",
    "expect": {
      "status": ">"
    }
  },
  {
    "name": "empty task body",
    "line": "- [ ] ",
    "expect": {
      "text": ""
    }
  },
  {
    "name": "Tasks: full emoji set",
